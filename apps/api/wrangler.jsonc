{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-with-nextjs-hono-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chat-with-nextjs-hono-db",
      // ローカル開発では未使用。リモート用は `wrangler d1 create` で発行した ID に置き換える。
      "database_id": "local-placeholder",
      "migrations_dir": "migrations"
    }
  ]
}
